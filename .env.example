# Every environment variable the app reads, with harmless placeholder values.
# Copy to .env for local use (.env is in .gitignore). Real values go into Render's
# Environment settings, never into git and never into an agent chat.

# Required: the app refuses to start without it.
# A long random string that signs the session cookie: openssl rand -hex 32
SESSION_SECRET=change-me

# Postgres connection string from the Neon dashboard (Connect). Required from step 3 on.
DATABASE_URL=postgresql://user:password@host/dbname
# The SQLite file used until the move to Postgres. Default data/app.db.
DB_PATH=data/app.db

# The port the app listens on. Render sets it itself. Default 3000.
PORT=3000
# "production" on Render: secure cookies and no seed data. Leave empty locally.
NODE_ENV=
# Time zone for "today" and booking dates. Without it, the server uses UTC.
TZ=Europe/Sofia
# The public address of the app, used for the Google redirect URI: your Render URL in production.
PUBLIC_BASE_URL=http://localhost:3000

# Sign in with Google (step 8). Create an OAuth client at console.cloud.google.com and leave it
# in "Testing" mode with yourself as a test user. Add every address you sign in from as an
# authorized redirect URI, including the codespace's forwarded URL and the Render URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The model feature. A free key comes from aistudio.google.com. Optional: without it the
# search box shows its fallback message and the pickers still work.
GEMINI_API_KEY=
MODEL_NAME=gemini-3.5-flash-lite

# Only for the MCP server, never on Render: a personal token printed once by
# npm run mcp-token -- <email>. It grants what that user may do, and nothing more.
MCP_TOKEN=
